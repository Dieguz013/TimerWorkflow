<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Serve solo per caricare i font online; l'app funziona anche offline con i font di sistema -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifica del timer e avvisi di fase -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Servizio in primo piano che mantiene viva la sessione in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Allarme esatto a fine fase (timer) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Notifiche "Live" di Android 16 (Samsung Now Bar con One UI 8) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Console Operativa"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- configChanges: evita che la rotazione ricrei l'activity e azzeri la sessione in corso.
             singleTask: toccando la notifica si riapre l'app gia' in esecuzione. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="timer_phase_tracking" />
        </service>

        <receiver
            android:name=".PhaseAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
